  "item": [
    {
      "name": "Create iPhone 15",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/products",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"iPhone 15\",\n  \"price\": 999.99,\n  \"stock\": 50,\n  \"category\": \"Electronics\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"productId1\", pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
